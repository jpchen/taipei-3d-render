{
  "name": "taipei-at-dusk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An explorable Taipei sunset built with Three.js, Blender and real map data.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "data:map": "node scripts/fetch-map.mjs",
    "data:terrain": "node scripts/fetch-terrain.mjs",
    "data:prepare": "node scripts/prepare-city.mjs",
    "models": "blender -b --python scripts/build-landmarks.py",
    "test": "playwright test",
    "data:activity": "node scripts/prepare-activity.mjs",
    "models:city": "blender -b --python scripts/build-city-landmarks.py",
    "data:labels": "node scripts/prepare-labels.mjs"
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  }
}
